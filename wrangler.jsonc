{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bambino",
  "main": ".open-next/worker.js",
  // Pinned to the day this was set up. Moving it forward opts into newer
  // runtime behaviour; do it deliberately, not by accident.
  "compatibility_date": "2026-09-09",
  // nodejs_compat is required by OpenNext. With a compatibility date past
  // 2025-04-01 it also populates process.env from vars and secrets, which is
  // how DATABASE_URL and the Supabase keys reach the app unchanged.
  "compatibility_flags": ["nodejs_compat"],
  // The shop's address. Both hostnames are Workers Custom Domains: Cloudflare
  // owns the DNS records and the certificate, and the zone must hold no other
  // A/AAAA/CNAME for them or the deploy refuses to bind.
  "routes": [
    { "pattern": "bambino.ltd", "custom_domain": true },
    { "pattern": "www.bambino.ltd", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Hyperdrive keeps a warm connection pool to Supabase near the database, so
  // the per-request client in src/db/client.ts pays one short hop instead of a
  // fresh TCP + TLS + auth handshake from Kuwait to Mumbai on every request.
  // The config (and the database password) live in Cloudflare, not here.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "ac9db2ff3e2842f59b6af38f5314d407" }
  ],
  "observability": {
    "enabled": true
  }
}
